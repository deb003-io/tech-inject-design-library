# Copy to .env and set real secrets. Never commit real secrets or customer data.
PORT=4000
DATABASE_PATH=./data/db.json
JWT_SECRET=change-me-to-32-plus-characters-long-secret
JWT_EXPIRES_IN=12h
# Admin: set either a plaintext password (hashed at boot, dev) or a bcrypt hash.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=AdminPass123!
# ADMIN_PASSWORD_HASH=$2b$10$REPLACE_WITH_BCRYPT_HASH_OF_ADMIN_PASSWORD
SEED_FREE_EMAIL=free@example.com
SEED_FREE_PASSWORD=FreePass123!
SEED_PREMIUM_EMAIL=premium@example.com
SEED_PREMIUM_PASSWORD=PremiumPass123!
# Backend origin, used for install commands and agent prompts:
PUBLIC_API_URL=http://localhost:4000/api
# Frontend build-time API base (catalogue + admin):
NEXT_PUBLIC_API_URL=http://localhost:4000/api
